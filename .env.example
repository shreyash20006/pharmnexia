# ==============================================================================
# PHARMNEXIA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Vite, all client-exposed environment variables MUST start with "VITE_"
# Copy this file to .env.local for local development.
# For Vercel deployment, add these keys under: Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (REQUIRED FOR LIVE DATABASE)
# ------------------------------------------------------------------------------
# Retrieve from: Supabase Dashboard -> Project Settings -> API
# Project URL (e.g., https://xyzcompanyref.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous API Key (safe for browser client-side usage)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ------------------------------------------------------------------------------
# 2. APPLICATION URL & ENVIRONMENT
# ------------------------------------------------------------------------------
# Your live Vercel production URL or custom domain
VITE_SITE_URL=https://pharmnexia.vercel.app

# Environment identifier ('production' or 'development')
VITE_APP_ENV=production

# ------------------------------------------------------------------------------
# 3. RAZORPAY PAYMENT GATEWAY (OPTIONAL / SESSIONS & CERTIFICATES)
# ------------------------------------------------------------------------------
# Test or Live Public Key ID from Razorpay Dashboard -> Settings -> API Keys
# Format: rzp_test_... or rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_yourkeyidhere
